# Supabase (same project as web/app; admin uses anon + RLS / service role as needed)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: used by super-admin Search AI desk to invoke embedding edge functions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: QA Hub "Trigger CI suite" button (workflow_dispatch on safety-tests.yml)
GITHUB_TOKEN=
GITHUB_REPO=owner/store-link-mobile
GITHUB_SAFETY_WORKFLOW=safety-tests.yml
GITHUB_SAFETY_REF=main
