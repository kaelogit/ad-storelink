# Supabase (same project as web/app; admin uses anon + RLS / service role as needed)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: used by super-admin Search AI desk to invoke embedding edge functions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Same value as Edge Function secret CRON_SECRET (Dashboard → Edge Functions → Secrets).
# Sent as x-cron-secret so generate-*-embeddings authorizeMoneyCron accepts admin runs.
# CRON_SECRET=

# Optional fallback: if Edge returns Unauthorized, Search AI embeds directly via Gemini.
# Same key as the Edge Function secret GEMINI_API_KEY.
# GEMINI_API_KEY=

# Paystack refunds (booking/order force-status). MUST be secret keys (sk_live_ / sk_test_), never pk_.
# PAYSTACK_SECRET_KEY=sk_live_...
# PAYSTACK_SECRET_KEY_NG=sk_live_...
# PAYSTACK_SECRET_KEY_GH=sk_live_...


# Optional: QA Hub "Trigger CI suite" button (workflow_dispatch on safety-tests.yml)
GITHUB_TOKEN=
GITHUB_REPO=owner/store-link-mobile
GITHUB_SAFETY_WORKFLOW=safety-tests.yml
GITHUB_SAFETY_REF=main
